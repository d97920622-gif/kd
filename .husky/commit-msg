#!/usr/bin/env sh
# path: .husky/commit-msg
# Conventional commit gate for KD SOLUTION IT.
# Convention: docs/PLAN/07_BRANCH_AND_GIT_WORKFLOW.md section 3.
#   <type>(step-NN/S.S): <imperative summary>
# Allowed types: feat fix refactor perf docs chore security
# Rule 1 also applies to commit messages: English only, ASCII only.

MSG_FILE="$1"
SUBJECT=$(head -n 1 "$MSG_FILE")

# Git-generated messages are always acceptable.
case "$SUBJECT" in
  Merge\ * | Revert\ * | fixup!\ * | squash!\ *)
    exit 0
    ;;
esac

PATTERN='^(feat|fix|refactor|perf|docs|chore|security)\([a-z0-9._/-]+\): [A-Za-z0-9].{2,}$'
if ! printf '%s' "$SUBJECT" | grep -Eq "$PATTERN"; then
  echo "commit-msg: rejected subject line: $SUBJECT" >&2
  echo "commit-msg: expected <type>(scope): <summary>" >&2
  echo "commit-msg: allowed types: feat fix refactor perf docs chore security" >&2
  echo "commit-msg: example: feat(step-01/1.2): add eslint configuration" >&2
  exit 1
fi

LENGTH=$(printf '%s' "$SUBJECT" | tr -d '\n' | wc -c | tr -d ' ')
if [ "$LENGTH" -gt 72 ]; then
  echo "commit-msg: subject line is longer than 72 characters" >&2
  exit 1
fi

case "$SUBJECT" in
  *.)
    echo "commit-msg: subject line must not end with a period" >&2
    exit 1
    ;;
esac

NON_ASCII_BYTES=$(tr -d '\000-\177' <"$MSG_FILE" | wc -c | tr -d ' ')
if [ "$NON_ASCII_BYTES" -gt 0 ]; then
  echo "commit-msg: message contains non-ASCII characters (Rule 1: English only)" >&2
  exit 1
fi

exit 0
