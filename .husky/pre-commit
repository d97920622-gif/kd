#!/usr/bin/env sh
# path: .husky/pre-commit
# Pre-commit quality gate for KD SOLUTION IT.
#
# 1. lint-staged runs ESLint and Prettier on the staged files.
# 2. npm run verify runs the full gate: typecheck, lint, format check,
#    environment validation and the twelve rule checks.
#
# A failing gate keeps the commit out of history. The same command runs in
# CI, so a local pass and a pipeline pass mean the same thing.

npx lint-staged || exit 1
npm run verify || exit 1

exit 0
