# path: .gitignore
# Dependencies
node_modules/
.pnp
.pnp.js

# Next.js build output
.next/
out/
build/
dist/
.turbo/
.swc/

# Environment files (never commit secrets)
.env
.env.*
!.env.example

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Caches
.cache/
.eslintcache
.prettiercache
coverage/
.nyc_output/

# Deployment and hosting
.netlify/
.vercel/

# Docker and local databases
docker/volumes/
*.sql.gz

# Editors and operating systems
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
.DS_Store
Thumbs.db

# Temporary and generated files
tmp/
temp/
*.tsbuildinfo

# Secrets and certificates (never commit, in any format)
*.pem
*.key
*.p12
*.pfx
secrets/

# Local quality report output
lighthouse/
verify-report.txt
