# path: .env.example
# KD SOLUTION IT environment template.
#
# Copy this file to .env for local development and fill real values there.
# .env is gitignored and must never be committed (check:secrets enforces it).
# Production values come from the deployment environment, never from a file
# in the repository. Later steps append their variables to this file.

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------

# development | test | production. Production enables the strict checks in
# lib/env/validate-env.ts at server boot.
NODE_ENV=development

# Public origin of the application. Must be the real HTTPS origin in
# production; used for absolute URLs, canonical tags and redirects.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# debug | info | warn | error. Level of the structured logger (sub-step 1.8).
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Database -- migrations and direct SQL (step 2)
# ---------------------------------------------------------------------------

# Direct PostgreSQL connection used by npm run db:migrate, db:rollback and
# db:seed. It is read from the environment and never printed. The application
# itself reaches the database through the Supabase URL and keys below, so this
# value is only needed where migrations run. Never commit a real value.
DATABASE_URL=

# ---------------------------------------------------------------------------
# Supabase (PostgreSQL, auth, realtime) -- added by step 2 and step 3
# ---------------------------------------------------------------------------

# Project URL, for example https://abcdefghijklmnop.supabase.co
SUPABASE_URL=

# Public anonymous key. Safe for the browser because RLS is default-deny.
SUPABASE_ANON_KEY=

# Service role key. Server only. Bypasses RLS, must never reach the browser,
# a log line or an API response.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Audit signing -- added by step 2.8
# ---------------------------------------------------------------------------

# Identifier of the Ed25519 audit signing key, 3 to 64 characters. It is written
# into each signature, so verification finds the public key. A rotation uses a
# new identifier and never reuses an old one.
AUDIT_SIGNING_KEY_ID=

# PKCS#8 PEM of the Ed25519 private key, read only by npm run db:audit:sign. It
# is environment only: never in the database, never in the repository, never in
# a log. The database holds the public key alone.
AUDIT_SIGNING_PRIVATE_KEY=

# ---------------------------------------------------------------------------
# Encryption root key -- added by step 2.9
# ---------------------------------------------------------------------------

# Root key for field encryption and blind indexes: 32 random bytes in base64,
# 44 characters including one '=' padding character. Generate it with
#   openssl rand -base64 32
# Every encryption key is derived from it. It never rotates (rotation changes
# the derived versions, not this value). Required in production; the value is
# never printed, logged or stored in the database. Losing it makes every stored
# encrypted value unreadable.
ENCRYPTION_KEY=
