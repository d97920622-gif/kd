{
  "name": "kd-solution-it",
  "version": "0.1.0",
  "private": true,
  "description": "KD SOLUTION IT enterprise multi-tenant SaaS platform for invoicing, payments, payroll and accounting. USD only, English only.",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/d97920622-gif/kd.git"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx,.mjs --max-warnings=0",
    "lint:fix": "eslint . --ext .js,.jsx,.ts,.tsx,.mjs --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "env:validate": "tsx --env-file-if-exists=.env lib/env/cli.ts",
    "tokens:export": "tsx scripts/export-design-tokens.ts",
    "brand:generate": "tsx scripts/generate-brand-assets.ts",
    "check:brand-assets": "node scripts/checks/brand-assets.mjs",
    "check:nav-map": "node scripts/checks/nav-map.mjs",
    "check:page-states": "node scripts/checks/page-states.mjs",
    "verify": "node scripts/verify.mjs",
    "test": "npm run verify",
    "check:english-only": "node scripts/checks/english-only.mjs",
    "check:no-todo": "node scripts/checks/no-todo.mjs",
    "check:no-coming-soon": "node scripts/checks/no-coming-soon.mjs",
    "check:no-tests": "node scripts/checks/no-tests.mjs",
    "check:path-comment": "node scripts/checks/path-comment.mjs",
    "check:i18n-strings": "node scripts/checks/i18n-strings.mjs",
    "check:design-tokens": "node scripts/checks/design-tokens.mjs",
    "check:no-console": "node scripts/checks/no-console.mjs",
    "check:forbidden-brands": "node scripts/checks/forbidden-brands.mjs",
    "check:migration-pairs": "node scripts/checks/migration-pairs.mjs",
    "check:dead-links": "node scripts/checks/dead-links.mjs",
    "check:secrets": "node scripts/checks/secrets.mjs",
    "check:any-types": "node scripts/checks/any-types.mjs",
    "check:money-math": "node scripts/checks/money-math.mjs",
    "prepare": "husky"
  },
  "lint-staged": {
    "!(*.d).{js,jsx,mjs,ts,tsx}": [
      "eslint --fix --max-warnings=0",
      "prettier --write"
    ],
    "*.{css,md,json,yml,yaml}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-radio-group": "^1.5.1",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-toast": "^1.3.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "decimal.js": "^10.6.0",
    "lucide-react": "^1.57.0",
    "next": "^15.5.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.90.0",
    "tailwind-merge": "^2.6.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.71.2",
    "@typescript-eslint/parser": "^8.71.2",
    "autoprefixer": "^10.6.1",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.5.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2",
    "postcss": "^8.5.30",
    "prettier": "^3.9.0",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
